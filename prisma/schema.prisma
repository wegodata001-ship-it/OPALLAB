model LabSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Manager Calendar V1 — modular calendar engine (calendarKey allows future staff/courier calendars).
enum CalendarEventType {
  DOCTOR_MEETING
  NEW_CLIENT
  DELIVERY
  PICKUP
  TASK
  VACATION
  BLOCKED
  REVIEW
  TEAM_MEETING
  REMINDER
}

enum CalendarEventStatus {
  CONFIRMED
  PENDING
  DONE
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model CalendarEvent {
  id            String              @id @default(cuid())
  /// Future multi-calendar: "manager" | "user:{id}" | "dept:cad" etc.
  calendarKey   String              @default("manager")
  title         String
  description   String?
  location      String?
  type          CalendarEventType
  status        CalendarEventStatus @default(CONFIRMED)
  color         String?
  startsAt      DateTime
  endsAt        DateTime
  allDay        Boolean             @default(false)
  /// Auto-created from orders/shipments — secretary cannot delete.
  isSystem      Boolean             @default(false)
  notes         String?
  phone         String?
  patientName   String?
  doctorName    String?
  orderId       String?
  doctorId      String?
  patientId     String?
  createdById   String?
  ownerUserId   String?
  /// Simple recurrence: { freq: "DAILY"|"WEEKLY"|"MONTHLY"|"YEARLY", until?: ISO, count?: number, interval?: number }
  recurrence    Json?
  /// Reminders: [{ minutesBefore: 10|30|60|1440|10080, channel: "APP"|"WHATSAPP"|"EMAIL" }]
  reminders     Json                @default("[]")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  owner     User?    @relation("CalendarEventOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([calendarKey, startsAt])
  @@index([startsAt, endsAt])
  @@index([type, status])
  @@index([orderId])
  @@index([doctorId])
}
