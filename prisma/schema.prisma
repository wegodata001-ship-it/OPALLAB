// OPAL LAB - Dental Laboratory Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SECRETARY
  DESIGNER
  PRINTER
  MILLING
  PROCESSING
  FINISH
  PACKAGING
  DOCTOR
  OWNER
}

enum Gender {
  MALE
  FEMALE
}

enum MaterialType {
  TEMPORARY
  DENTURE
  PFM
  ZIRCONIA
  TITANIUM
  MODEL
}

enum WorkType {
  SCREWED
  ABUTMENTS
  MOCKUP
  BAR
  NIGHT_GUARD_WHITENING_MILLED
}

enum OrderStatus {
  RECEIVED
  FILES_ATTACHED
  DESIGN
  PRINTING_3D
  MILLING
  PROCESSING
  FINISH
  PACKAGING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InventoryType {
  RAW_MATERIALS
  PARTS_COMPONENTS
  OWNER_ASSETS
}

enum FileType {
  PLX
  STL
  OBJ
  PLY
  OTHER_3D
  IMAGE
  DOCUMENT
}

enum AttendanceMethod {
  NFC
  MANUAL
  GEOFENCE_AUTO
  WIFI
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum SalaryType {
  MONTHLY
  HOURLY
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  CREDIT_CARD
}

enum TransactionType {
  PAYMENT
  CHARGE
  SALARY
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

model User {
  id         String      @id @default(cuid())
  username   String      @unique
  password   String
  email      String      @unique
  name       String
  phone      String?
  role       UserRole
  nfcTagId   String?     @unique
  address    String?
  salary     Float?
  salaryType SalaryType?
  hourlyRate Float?
  color      String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  doctor             Doctor?
  assignedOrders     Order[]              @relation("AssignedDesigner")
  processingOrders   Order[]              @relation("ProcessingEmployee")
  finishOrders       Order[]              @relation("FinishEmployee")
  statusChanges      OrderStatusHistory[]
  attendanceRecords  AttendanceRecord[]
  inventoryMovements InventoryMovement[]
  employeePayments   Payment[]            @relation("EmployeePayments")

  @@index([role, isActive])
}

model Doctor {
  id            String        @id @default(cuid())
  userId        String?       @unique
  name          String
  clinic        String?
  phone         String?
  email         String?
  address       String?
  balance       Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  orders   Order[]
  payments Payment[]

  @@index([name])
  @@index([paymentStatus])
}

model Courier {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  age       Int?
  gender    Gender?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([name])
}

model Order {
  id                   String         @id @default(cuid())
  serialNumber         String         @unique
  doctorId             String
  patientId            String
  entryDate            DateTime       @default(now())
  completionDate       DateTime?
  shade                String?
  materials            MaterialType[]
  workTypes            WorkType[]
  selectedTeeth        Int[]
  description          String?
  status               OrderStatus    @default(RECEIVED)
  assignedDesignerId   String?
  processingEmployeeId String?
  finishEmployeeId     String?
  totalPrice           Float?
  notes                String?
  completedStages      Json           @default("{}")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  doctor             Doctor               @relation(fields: [doctorId], references: [id])
  patient            Patient              @relation(fields: [patientId], references: [id])
  assignedDesigner   User?                @relation("AssignedDesigner", fields: [assignedDesignerId], references: [id])
  processingEmployee User?                @relation("ProcessingEmployee", fields: [processingEmployeeId], references: [id])
  finishEmployee     User?                @relation("FinishEmployee", fields: [finishEmployeeId], references: [id])
  files              OrderFile[]
  statusHistory      OrderStatusHistory[]
  shipment           Shipment?
  inventoryUsages    InventoryUsage[]
  payments           Payment[]

  @@index([status])
  @@index([doctorId])
  @@index([entryDate])
  @@index([createdAt])
}

model OrderFile {
  id          String   @id @default(cuid())
  orderId     String
  fileName    String
  fileType    FileType
  fileSize    Int?
  storagePath String?
  bucket      String?
  mimeType    String?
  uploadedBy  String
  uploadedAt  DateTime @default(now())
  notes       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedBy String
  notes     String?
  createdAt DateTime    @default(now())

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changer User  @relation(fields: [changedBy], references: [id])

  @@index([orderId, createdAt])
}

model InventoryCategory {
  id       String  @id
  name     String
  color    String
  isSystem Boolean @default(false)

  @@index([isSystem])
}

model InventoryItem {
  id            String   @id @default(cuid())
  inventoryType String
  name          String
  barcode       String   @unique
  description   String?
  imageUrl      String?
  storagePath   String?
  purchaseCost  Float
  quantity      Int      @default(0)
  minQuantity   Int      @default(0)
  unit          String   @default("יחידה")
  location      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements InventoryMovement[]
  usages    InventoryUsage[]

  @@index([inventoryType, isActive])
  @@index([name])
}

model InventoryMovement {
  id          String       @id @default(cuid())
  itemId      String
  quantity    Int
  type        MovementType
  unitCost    Float        @default(0)
  notes       String?
  orderRef    String?
  performedBy String
  createdAt   DateTime     @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id])
  performer User          @relation(fields: [performedBy], references: [id])

  @@index([itemId, createdAt])
}

model InventoryUsage {
  id       String @id @default(cuid())
  orderId  String
  itemId   String
  quantity Int

  order Order         @relation(fields: [orderId], references: [id])
  item  InventoryItem @relation(fields: [itemId], references: [id])
}

model Shipment {
  id           String    @id @default(cuid())
  orderId      String    @unique
  deliveryNote String    @unique
  packagedBy   String?
  packagedAt   DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  courierName  String?
  courierPhone String?
  notes        String?
  createdAt    DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([deliveryNote])
}

model Payment {
  id              String         @id @default(cuid())
  doctorId        String?
  employeeId      String?
  orderId         String?
  serialNumber    String?
  patientName     String?
  amount          Float
  type            TransactionType
  status          PaymentStatus
  description     String?
  paidAt          DateTime?
  paymentMethod   PaymentMethod?
  referenceNumber String?
  deliveryNote    String?
  createdAt       DateTime       @default(now())

  doctor   Doctor? @relation(fields: [doctorId], references: [id])
  employee User?   @relation("EmployeePayments", fields: [employeeId], references: [id])
  order    Order?  @relation(fields: [orderId], references: [id])

  @@index([doctorId, createdAt])
  @@index([employeeId, createdAt])
  @@index([orderId])
  @@index([type, status])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  userId    String
  checkIn   DateTime
  checkOut  DateTime?
  method    AttendanceMethod
  nfcTagId  String?
  latitude  Float?
  longitude Float?
  notes     String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, checkIn])
  @@index([checkOut])
}

model LabSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
