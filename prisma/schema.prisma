// OPAL LAB - Dental Laboratory Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SECRETARY
  DESIGNER
  PRINTER
  MILLING
  PROCESSING
  FINISH
  PACKAGING
  DOCTOR
  OWNER
}

enum Gender {
  MALE
  FEMALE
}

enum MaterialType {
  TEMPORARY
  DENTURE
  PFM
  ZIRCONIA
  TITANIUM
  MODEL
}

enum WorkType {
  SCREWED
  ABUTMENTS
  MOCKUP
  BAR
  NIGHT_GUARD_WHITENING_MILLED
}

/// Admin-managed options for order form chips (materials / work types / shades).
enum OrderCatalogCategory {
  MATERIAL
  WORK_TYPE
  SHADE
}

enum OrderStatus {
  DRAFT
  RECEIVED
  FILES_ATTACHED
  DESIGN
  PRINTING_3D
  MILLING
  PROCESSING
  FINISH
  PACKAGING
  SHIPPED
  DELIVERED
  CANCELLED
  DELETED
}

enum InventoryType {
  RAW_MATERIALS
  PARTS_COMPONENTS
  OWNER_ASSETS
}

enum FileType {
  PLX
  STL
  OBJ
  PLY
  OTHER_3D
  IMAGE
  DOCUMENT
}

enum OrderFileCategory {
  ClinicalPhotos
  Scans
  Radiographs
  Prescription
  Documents
  CAD
  Manufacturing
  Delivery
  Other
}

enum AttendanceMethod {
  NFC
  MANUAL
  GEOFENCE_AUTO
  WIFI
  GPS
  TRUSTED_DEVICE
}

enum TrustedDeviceStatus {
  ACTIVE
  BLOCKED
  REVOKED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum SalaryType {
  MONTHLY
  HOURLY
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  CREDIT_CARD
}

enum TransactionType {
  PAYMENT
  CHARGE
  SALARY
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  CATEGORY_CHANGE
  EDIT
  DELETE
}

model User {
  id         String      @id @default(cuid())
  username   String      @unique
  password   String
  email      String      @unique
  name       String
  phone      String?
  role       UserRole
  roles      UserRole[]  @default([])
  authUserId String?     @unique
  nfcTagId   String?     @unique
  address    String?
  salary     Float?
  salaryType SalaryType?
  hourlyRate Float?
  color      String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  doctor             Doctor?
  assignedOrders     Order[]              @relation("AssignedDesigner")
  processingOrders   Order[]              @relation("ProcessingEmployee")
  finishOrders       Order[]              @relation("FinishEmployee")
  deletedOrders      Order[]              @relation("OrderDeletedBy")
  calendarEventsCreated CalendarEvent[]   @relation("CalendarEventCreatedBy")
  calendarEventsOwned   CalendarEvent[]   @relation("CalendarEventOwner")
  statusChanges      OrderStatusHistory[]
  attendanceRecords  AttendanceRecord[]
  trustedDevices     TrustedDevice[]
  inventoryMovements InventoryMovement[]
  employeePayments   Payment[]            @relation("EmployeePayments")
  auditLogs          AuditLog[]

  @@index([role, isActive])
}

model TrustedDevice {
  id                    String              @id @default(cuid())
  userId                String
  /// Client-generated trusted device id (localStorage) — not a hardware IMEI
  deviceKey             String              @unique
  label                 String?
  browser               String?
  os                    String?
  deviceType            String?
  userAgent             String?
  screenSize            String?
  timezone              String?
  status                TrustedDeviceStatus @default(ACTIVE)
  registeredAt          DateTime            @default(now())
  lastUsedAt            DateTime?
  lastIp                String?
  registrationLatitude  Float?
  registrationLongitude Float?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceRecords  AttendanceRecord[]

  @@index([userId, status])
  @@index([lastUsedAt])
}

model Doctor {
  id            String        @id @default(cuid())
  userId        String?       @unique
  name          String
  clinic        String?
  phone         String?
  email         String?
  address       String?
  balance       Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  orders   Order[]
  payments Payment[]
  calendarEvents CalendarEvent[]

  @@index([name])
  @@index([paymentStatus])
}

model Courier {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  age       Int?
  gender    Gender?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  calendarEvents CalendarEvent[]

  @@index([name])
}

model Order {
  id                   String         @id @default(cuid())
  serialNumber         String         @unique
  doctorId             String?
  patientId            String
  entryDate            DateTime       @default(now())
  completionDate       DateTime?
  shade                String?
  /// Codes from OrderCatalogOption (MATERIAL) — stored as text for admin-extensible catalog.
  materials            String[]
  /// Codes from OrderCatalogOption (WORK_TYPE) — stored as text for admin-extensible catalog.
  workTypes            String[]
  selectedTeeth        Int[]
  /// Contiguous FDI bridge groups, e.g. [[13,14,15],[21,22]]
  bridgeGroups         Json           @default("[]")
  /// Selected splint catalog ids (multi-select). Legacy single FK kept in sync as first id.
  splintTypeIds        String[]       @default([])
  /// Primary / legacy single relation — always equals splintTypeIds[0] when present.
  splintTypeId         String?
  description          String?
  status               OrderStatus    @default(RECEIVED)
  assignedDesignerId   String?
  processingEmployeeId String?
  finishEmployeeId     String?
  totalPrice           Float?
  notes                String?
  completedStages      Json           @default("{}")
  /// Soft-delete metadata (status = DELETED). Permanent delete clears the row.
  deletedAt            DateTime?
  deletedBy            String?
  deleteReason         String?
  statusBeforeDelete   OrderStatus?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  doctor             Doctor?              @relation(fields: [doctorId], references: [id])
  patient            Patient              @relation(fields: [patientId], references: [id])
  assignedDesigner   User?                @relation("AssignedDesigner", fields: [assignedDesignerId], references: [id])
  processingEmployee User?                @relation("ProcessingEmployee", fields: [processingEmployeeId], references: [id])
  finishEmployee     User?                @relation("FinishEmployee", fields: [finishEmployeeId], references: [id])
  deletedByUser      User?                @relation("OrderDeletedBy", fields: [deletedBy], references: [id])
  splintType         SplintType?          @relation(fields: [splintTypeId], references: [id])
  files              OrderFile[]
  statusHistory      OrderStatusHistory[]
  shipment           Shipment?
  inventoryUsages    InventoryUsage[]
  payments           Payment[]
  calendarEvents     CalendarEvent[]

  @@index([status])
  @@index([doctorId])
  @@index([entryDate])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([splintTypeId])
}

model OrderFile {
  id          String            @id @default(cuid())
  orderId     String
  fileName    String
  fileType    FileType
  fileSize    Int?
  storagePath String?
  bucket      String?
  mimeType    String?
  uploadedBy  String
  uploadedAt  DateTime          @default(now())
  notes       String?
  /// Storage taxonomy folder (ClinicalPhotos, Scans, …)
  category    OrderFileCategory @default(Other)
  /// Subfolder / clinical slot key (Smile, UpperScan, …)
  slotKey     String?
  /// Logical key for versioning within an order (e.g. clinical:Smile)
  versionKey  String?
  version     Int               @default(1)
  isCurrent   Boolean           @default(true)
  replacesId  String?
  /// Parsed once on upload: bbox, center, vertex/triangle counts (no re-parse for camera).
  modelMeta   Json?
  /// Storage path for PNG preview thumbnail (not Base64).
  thumbnailPath String?
  /// When mesh metadata was extracted.
  parsedAt    DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, category, isCurrent])
  @@index([orderId, versionKey, isCurrent])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedBy String
  notes     String?
  createdAt DateTime    @default(now())

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changer User  @relation(fields: [changedBy], references: [id])

  @@index([orderId, createdAt])
}

model InventoryCategory {
  id       String  @id
  name     String
  color    String
  isSystem Boolean @default(false)

  @@index([isSystem])
}

/// Admin-managed catalog of order-form options (materials, work types, shades).
model OrderCatalogOption {
  id        String               @id @default(cuid())
  category  OrderCatalogCategory
  code      String
  label     String
  /// Hex color for shade swatches (optional).
  color     String?
  /// Shade group: A | B | C | D | BL
  group     String?
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  isSystem  Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([category, code])
  @@index([category, isActive, sortOrder])
}

/// Admin-managed catalog of splint / night-guard product types (chips on orders).
model SplintType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, sortOrder])
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryItem {
  id            String   @id @default(cuid())
  inventoryType String
  name          String
  barcode       String   @unique
  description   String?
  imageUrl      String?
  storagePath   String?
  purchaseCost  Float
  quantity      Int      @default(0)
  minQuantity   Int      @default(0)
  unit          String   @default("יחידה")
  location      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements InventoryMovement[]
  usages    InventoryUsage[]

  @@index([inventoryType, isActive])
  @@index([name])
}

model InventoryMovement {
  id           String       @id @default(cuid())
  itemId       String
  quantity     Int
  type         MovementType
  unitCost     Float        @default(0)
  notes        String?
  orderRef     String?
  reason       String?
  supplier     String?
  fromCategory String?
  toCategory   String?
  fromLocation String?
  toLocation   String?
  performedBy  String
  createdAt    DateTime     @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id])
  performer User          @relation(fields: [performedBy], references: [id])

  @@index([itemId, createdAt])
}

model InventoryUsage {
  id       String @id @default(cuid())
  orderId  String
  itemId   String
  quantity Int

  order Order         @relation(fields: [orderId], references: [id])
  item  InventoryItem @relation(fields: [itemId], references: [id])
}

model Shipment {
  id           String    @id @default(cuid())
  orderId      String    @unique
  deliveryNote String    @unique
  packagedBy   String?
  packagedAt   DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  courierName  String?
  courierPhone String?
  notes        String?
  createdAt    DateTime  @default(now())
  /// Optional recipient signature PNG in Storage
  recipientSignaturePath String?
  recipientSignedAt      DateTime?
  recipientSignerName    String?
  recipientSignerUserId  String?
  recipientSignatureIp   String?
  recipientSignatureDeviceId String?
  /// When set, signature is read-only
  lockedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@index([deliveryNote])
}

model Payment {
  id              String         @id @default(cuid())
  doctorId        String?
  employeeId      String?
  orderId         String?
  serialNumber    String?
  patientName     String?
  amount          Float
  type            TransactionType
  status          PaymentStatus
  description     String?
  paidAt          DateTime?
  paymentMethod   PaymentMethod?
  referenceNumber String?
  deliveryNote    String?
  createdAt       DateTime       @default(now())

  doctor   Doctor? @relation(fields: [doctorId], references: [id])
  employee User?   @relation("EmployeePayments", fields: [employeeId], references: [id])
  order    Order?  @relation(fields: [orderId], references: [id])

  @@index([doctorId, createdAt])
  @@index([employeeId, createdAt])
  @@index([orderId])
  @@index([type, status])
}

model AttendanceRecord {
  id                String           @id @default(cuid())
  userId            String
  checkIn           DateTime
  checkOut          DateTime?
  method            AttendanceMethod
  trustedDeviceId   String?
  ipAddress         String?
  nfcTagId          String?
  latitude          Float?
  longitude         Float?
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkInAccuracy   Float?
  checkInAddress    String?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkOutAccuracy  Float?
  checkOutAddress   String?
  checkInAddressCountry     String?
  checkInAddressCity        String?
  checkInAddressStreet      String?
  checkInAddressHouseNumber String?
  checkOutAddressCountry     String?
  checkOutAddressCity        String?
  checkOutAddressStreet      String?
  checkOutAddressHouseNumber String?
  checkInDeviceBrowser  String?
  checkInDeviceOs       String?
  checkInDeviceType     String?
  checkInUserAgent      String?
  checkInScreenSize     String?
  checkInTimezone       String?
  checkOutDeviceBrowser String?
  checkOutDeviceOs      String?
  checkOutDeviceType    String?
  checkOutUserAgent     String?
  checkOutScreenSize    String?
  checkOutTimezone      String?
  deviceInfo        String?
  notes             String?
  createdAt         DateTime         @default(now())

  user          User           @relation(fields: [userId], references: [id])
  trustedDevice TrustedDevice? @relation(fields: [trustedDeviceId], references: [id], onDelete: SetNull)

  @@index([userId, checkIn])
  @@index([checkOut])
  @@index([trustedDeviceId])
}

model LabSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/// Manager Calendar V1 — modular calendar engine (calendarKey allows future staff/courier calendars).
enum CalendarEventType {
  DOCTOR_MEETING
  NEW_CLIENT
  DELIVERY
  PICKUP
  TASK
  VACATION
  BLOCKED
  REVIEW
  TEAM_MEETING
  REMINDER
}

enum CalendarEventStatus {
  CONFIRMED
  PENDING
  DONE
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

model CalendarEvent {
  id            String              @id @default(cuid())
  /// Future multi-calendar: "manager" | "user:{id}" | "dept:cad" etc.
  calendarKey   String              @default("manager")
  title         String
  description   String?
  location      String?
  type          CalendarEventType
  status        CalendarEventStatus @default(CONFIRMED)
  color         String?
  startsAt      DateTime
  endsAt        DateTime
  allDay        Boolean             @default(false)
  /// Auto-created from orders/shipments — secretary cannot delete.
  isSystem      Boolean             @default(false)
  notes         String?
  phone         String?
  patientName   String?
  doctorName    String?
  orderId       String?
  doctorId      String?
  patientId     String?
  createdById   String?
  ownerUserId   String?
  /// Simple recurrence: { freq: "DAILY"|"WEEKLY"|"MONTHLY"|"YEARLY", until?: ISO, count?: number, interval?: number }
  recurrence    Json?
  /// Reminders: [{ minutesBefore: 10|30|60|1440|10080, channel: "APP"|"WHATSAPP"|"EMAIL" }]
  reminders     Json                @default("[]")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CalendarEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  owner     User?    @relation("CalendarEventOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([calendarKey, startsAt])
  @@index([startsAt, endsAt])
  @@index([type, status])
  @@index([orderId])
  @@index([doctorId])
}
