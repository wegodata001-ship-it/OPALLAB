// OPAL LAB - Dental Laboratory Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SECRETARY
  DESIGNER
  PRINTER
  MILLING
  PROCESSING
  FINISH
  PACKAGING
  DOCTOR
  OWNER
  ASSISTANT
}

enum Gender {
  MALE
  FEMALE
}

enum MaterialType {
  TEMPORARY
  DENTURE
  PFM
  ZIRCONIA
  TITANIUM
  MODEL
}

enum WorkType {
  SCREWED
  ABUTMENTS
  MOCKUP
  BAR
  NIGHT_GUARD_WHITENING_MILLED
}

/// Admin-managed options for order form chips (materials / work types / shades / billable SKUs).
enum OrderCatalogCategory {
  MATERIAL
  WORK_TYPE
  SHADE
  /// Doctor price-book line items (may combine material + work semantics).
  BILLABLE
}

enum OrderStatus {
  DRAFT
  RECEIVED
  FILES_ATTACHED
  DESIGN
  PRINTING_3D
  MILLING
  PROCESSING
  FINISH
  PACKAGING
  SHIPPED
  DELIVERED
  CANCELLED
  DELETED
}

enum InventoryType {
  RAW_MATERIALS
  PARTS_COMPONENTS
  OWNER_ASSETS
}

enum FileType {
  PLX
  STL
  OBJ
  PLY
  OTHER_3D
  IMAGE
  DOCUMENT
}

enum OrderFileCategory {
  ClinicalPhotos
  Scans
  Radiographs
  Prescription
  Documents
  CAD
  Manufacturing
  Delivery
  Other
}

enum AttendanceMethod {
  NFC
  MANUAL
  GEOFENCE_AUTO
  WIFI
  GPS
  TRUSTED_DEVICE
}

enum TrustedDeviceStatus {
  ACTIVE
  BLOCKED
  REVOKED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum SalaryType {
  MONTHLY
  HOURLY
}

enum PaymentMethod {
  CASH
  CHECK
  TRANSFER
  CREDIT_CARD
}

enum TransactionType {
  PAYMENT
  CHARGE
  SALARY
  /// Signed delta against a work CHARGE (positive = more debt, negative = credit).
  ADJUSTMENT
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
  CATEGORY_CHANGE
  EDIT
  DELETE
}

enum BmmaStockAction {
  IN
  OUT
  SET
  COUNT
}

enum SimpleStockKind {
  CLINIC_MATERIALS
  OTHER_MATERIALS
}

enum SimpleStockAction {
  IN
  OUT
  SET
  COUNT
}

enum ImplantStockAction {
  IN
  OUT
  SET
  COUNT
}

enum DoctorPartMovementType {
  STOCK_IN
  STOCK_OUT
  ORDER_CONSUMPTION
  ORDER_ADJUSTMENT
  ORDER_RETURN
  MANUAL_CORRECTION
  STOCK_COUNT
}

enum InventoryModuleType {
  ZIRCONIA
  TITANIUM
  BMMA
  DRILLS
  IMPLANTS
  CLINIC_MATERIALS
  OTHER_MATERIALS
  DOCTOR_PARTS
}

enum InventoryCountStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum DrillStockAction {
  IN
  OUT
  SET
  COUNT
}

enum TitaniumStockAction {
  IN
  OUT
  SET
  COUNT
}

enum ZirconiaStockAction {
  IN
  OUT
  SET
  COUNT
}

model User {
  id         String      @id @default(cuid())
  username   String      @unique
  password   String
  email      String      @unique
  name       String
  phone      String?
  role       UserRole
  roles      UserRole[]  @default([])
  authUserId String?     @unique
  nfcTagId   String?     @unique
  address    String?
  salary     Float?
  salaryType SalaryType?
  hourlyRate Float?
  color      String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  doctor             Doctor?
  assignedOrders     Order[]              @relation("AssignedDesigner")
  processingOrders   Order[]              @relation("ProcessingEmployee")
  finishOrders       Order[]              @relation("FinishEmployee")
  deletedOrders      Order[]              @relation("OrderDeletedBy")
  calendarEventsCreated CalendarEvent[]   @relation("CalendarEventCreatedBy")
  calendarEventsOwned   CalendarEvent[]   @relation("CalendarEventOwner")
  statusChanges      OrderStatusHistory[]
  attendanceRecords  AttendanceRecord[]
  trustedDevices     TrustedDevice[]
  inventoryMovements InventoryMovement[]
  bmmaMovements      BmmaMovement[]
  simpleStockMovements SimpleStockMovement[]
  implantMovements     ImplantStockMovement[]
  doctorPartMovements  DoctorPartMovement[]
  zirconiaStockMovements ZirconiaStockMovement[]
  titaniumStockMovements TitaniumStockMovement[]
  drillStockMovements    DrillStockMovement[]
  inventoryCountsCreated InventoryCount[] @relation("InventoryCountCreatedBy")
  inventoryCountsApproved InventoryCount[] @relation("InventoryCountApprovedBy")
  inventoryImagesCreated InventoryImage[] @relation("InventoryImageCreatedBy")
  inventoryImagesUpdated InventoryImage[] @relation("InventoryImageUpdatedBy")
  inventoryScanCodesCreated InventoryScanCode[] @relation("InventoryScanCodeCreatedBy")
  inventoryScanCodesUpdated InventoryScanCode[] @relation("InventoryScanCodeUpdatedBy")
  employeePayments   Payment[]            @relation("EmployeePayments")
  auditLogs          AuditLog[]

  @@index([role, isActive])
}

model TrustedDevice {
  id                    String              @id @default(cuid())
  userId                String
  /// Client-generated trusted device id (localStorage) — not a hardware IMEI
  deviceKey             String              @unique
  label                 String?
  browser               String?
  os                    String?
  deviceType            String?
  userAgent             String?
  screenSize            String?
  timezone              String?
  status                TrustedDeviceStatus @default(ACTIVE)
  registeredAt          DateTime            @default(now())
  lastUsedAt            DateTime?
  lastIp                String?
  registrationLatitude  Float?
  registrationLongitude Float?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceRecords  AttendanceRecord[]

  @@index([userId, status])
  @@index([lastUsedAt])
}

model Doctor {
  id            String        @id @default(cuid())
  userId        String?       @unique
  name          String
  clinic        String?
  phone         String?
  email         String?
  address       String?
  balance       Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User?     @relation(fields: [userId], references: [id])
  orders   Order[]
  payments Payment[]
  calendarEvents CalendarEvent[]
  prices   DoctorPrice[]

  @@index([name])
  @@index([paymentStatus])
}

model Courier {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  age       Int?
  gender    Gender?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  calendarEvents CalendarEvent[]

  @@index([name])
}

model Order {
  id                   String         @id @default(cuid())
  serialNumber         String         @unique
  doctorId             String?
  patientId            String
  entryDate            DateTime       @default(now())
  completionDate       DateTime?
  shade                String?
  /// Codes from OrderCatalogOption (MATERIAL) — stored as text for admin-extensible catalog.
  materials            String[]
  /// Codes from OrderCatalogOption (WORK_TYPE) — stored as text for admin-extensible catalog.
  workTypes            String[]
  selectedTeeth        Int[]
  /// Contiguous FDI bridge groups, e.g. [[13,14,15],[21,22]]
  bridgeGroups         Json           @default("[]")
  /// Selected splint catalog ids (multi-select). Legacy single FK kept in sync as first id.
  splintTypeIds        String[]       @default([])
  /// Primary / legacy single relation — always equals splintTypeIds[0] when present.
  splintTypeId         String?
  description          String?
  status               OrderStatus    @default(RECEIVED)
  assignedDesignerId   String?
  processingEmployeeId String?
  finishEmployeeId     String?
  totalPrice           Float?
  /// Linked work CHARGE payment id (at most one work charge per order).
  ledgerChargeId       String?
  /// Snapshot of priced lines at save time — never rewritten when price book changes.
  priceLines           Json           @default("[]")
  /// Effective unit price used for the calculated total (primary line when single SKU).
  priceUnit            Float?
  /// Billing quantity at save — unique selected teeth count (or 1 for non-tooth / repair).
  priceQuantity        Int?
  /// Auto total before manual override (unit × quantity or sum of lines).
  calculatedPrice      Float?
  /// True when totalPrice was edited away from calculatedPrice.
  priceManuallyEdited  Boolean        @default(false)
  /// Pricing path: REGULAR | ALL_IN_X | OTHER
  pricingMode          String         @default("REGULAR")
  /// ALL IN X catalog code (e.g. ALL_IN_X_ZIRCONIA)
  allInXType           String?
  /// Snapshot: price per jaw for ALL_IN_X at save time.
  pricePerJaw          Float?
  /// Snapshot: number of jaws billed (0–2).
  jawCount             Int?
  /// OTHER work subtype: REWORK_FREE | REPAIR_OTHER
  otherWorkKind        String?
  /// Free-text description / notes for OTHER work.
  otherWorkNotes       String?
  notes                String?
  completedStages      Json           @default("{}")
  /// Soft-delete metadata (status = DELETED). Permanent delete clears the row.
  deletedAt            DateTime?
  deletedBy            String?
  deleteReason         String?
  statusBeforeDelete   OrderStatus?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  doctor             Doctor?              @relation(fields: [doctorId], references: [id])
  patient            Patient              @relation(fields: [patientId], references: [id])
  assignedDesigner   User?                @relation("AssignedDesigner", fields: [assignedDesignerId], references: [id])
  processingEmployee User?                @relation("ProcessingEmployee", fields: [processingEmployeeId], references: [id])
  finishEmployee     User?                @relation("FinishEmployee", fields: [finishEmployeeId], references: [id])
  deletedByUser      User?                @relation("OrderDeletedBy", fields: [deletedBy], references: [id])
  splintType         SplintType?          @relation(fields: [splintTypeId], references: [id])
  files              OrderFile[]
  statusHistory      OrderStatusHistory[]
  shipment           Shipment?
  inventoryUsages    InventoryUsage[]
  orderParts         OrderPart[]
  doctorPartMovements DoctorPartMovement[]
  payments           Payment[]
  calendarEvents     CalendarEvent[]

  @@index([status])
  @@index([doctorId])
  @@index([entryDate])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([splintTypeId])
}

model OrderFile {
  id          String            @id @default(cuid())
  orderId     String
  fileName    String
  fileType    FileType
  fileSize    Int?
  storagePath String?
  bucket      String?
  mimeType    String?
  uploadedBy  String
  uploadedAt  DateTime          @default(now())
  notes       String?
  /// Storage taxonomy folder (ClinicalPhotos, Scans, …)
  category    OrderFileCategory @default(Other)
  /// Subfolder / clinical slot key (Smile, UpperScan, …)
  slotKey     String?
  /// Logical key for versioning within an order (e.g. clinical:Smile)
  versionKey  String?
  version     Int               @default(1)
  isCurrent   Boolean           @default(true)
  replacesId  String?
  /// Parsed once on upload: bbox, center, vertex/triangle counts (no re-parse for camera).
  modelMeta   Json?
  /// Storage path for PNG preview thumbnail (not Base64).
  thumbnailPath String?
  /// When mesh metadata was extracted.
  parsedAt    DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderId, category, isCurrent])
  @@index([orderId, versionKey, isCurrent])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedBy String
  notes     String?
  createdAt DateTime    @default(now())

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changer User  @relation(fields: [changedBy], references: [id])

  @@index([orderId, createdAt])
}

model InventoryCategory {
  id       String  @id
  name     String
  color    String
  isSystem Boolean @default(false)

  @@index([isSystem])
}

/// Admin-managed catalog of order-form options (materials, work types, shades).
model OrderCatalogOption {
  id        String               @id @default(cuid())
  category  OrderCatalogCategory
  code      String
  label     String
  /// Hex color for shade swatches (optional).
  color     String?
  /// Shade group: A | B | C | D | BL
  group     String?
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  isSystem  Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([category, code])
  @@index([category, isActive, sortOrder])

  doctorPrices DoctorPrice[]
}

/// Per-doctor unit price for a BILLABLE catalog option.
model DoctorPrice {
  id               String   @id @default(cuid())
  doctorId         String
  catalogOptionId  String
  price            Float
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  doctor        Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  catalogOption OrderCatalogOption @relation(fields: [catalogOptionId], references: [id], onDelete: Cascade)

  @@unique([doctorId, catalogOptionId])
  @@index([doctorId, isActive])
  @@index([catalogOptionId])
}

/// Admin-managed catalog of splint / night-guard product types (chips on orders).
model SplintType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, sortOrder])
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryItem {
  id            String   @id @default(cuid())
  inventoryType String
  name          String
  barcode       String   @unique
  description   String?
  imageUrl      String?
  storagePath   String?
  purchaseCost  Float
  quantity      Int      @default(0)
  minQuantity   Int      @default(0)
  unit          String   @default("יחידה")
  location      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements InventoryMovement[]
  usages    InventoryUsage[]

  @@index([inventoryType, isActive])
  @@index([name])
}

model InventoryMovement {
  id           String       @id @default(cuid())
  itemId       String
  quantity     Int
  type         MovementType
  unitCost     Float        @default(0)
  notes        String?
  orderRef     String?
  reason       String?
  supplier     String?
  fromCategory String?
  toCategory   String?
  fromLocation String?
  toLocation   String?
  performedBy  String
  createdAt    DateTime     @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id])
  performer User          @relation(fields: [performedBy], references: [id])

  @@index([itemId, createdAt])
}

model InventoryUsage {
  id       String @id @default(cuid())
  orderId  String
  itemId   String
  quantity Int

  order Order         @relation(fields: [orderId], references: [id])
  item  InventoryItem @relation(fields: [itemId], references: [id])
}

/// Zirconia catalog model. The display name is editable; the id stays stable.
model ZirconiaModel {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributes ZirconiaAttribute[]
  variants   ZirconiaVariant[]
  colors     ZirconiaColor[]
  heights    ZirconiaHeight[]
  products   ZirconiaProduct[]

  @@index([sortOrder])
}

/// Sub-model under a zirconia model, such as LU or ZOLG under AM.
model ZirconiaVariant {
  id                String    @id @default(cuid())
  modelId           String
  name              String
  sortOrder         Int       @default(0)
  archivedAt        DateTime?
  sourceAttributeId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  model  ZirconiaModel   @relation(fields: [modelId], references: [id], onDelete: Restrict)
  colors ZirconiaColor[]

  @@index([modelId, sortOrder])
}

/// Named attribute of a zirconia model (for example color or length).
model ZirconiaAttribute {
  id        String   @id @default(cuid())
  modelId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model  ZirconiaModel            @relation(fields: [modelId], references: [id], onDelete: Cascade)
  values ZirconiaAttributeValue[]

  @@index([modelId, sortOrder])
}

/// A single selectable value under a zirconia attribute.
model ZirconiaAttributeValue {
  id          String   @id @default(cuid())
  attributeId String
  label       String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attribute ZirconiaAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@index([attributeId, sortOrder])
}

/// Color available on one zirconia model. Names come from the lab, not from a sample list.
model ZirconiaColor {
  id         String    @id @default(cuid())
  modelId    String
  variantId  String?
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  model    ZirconiaModel     @relation(fields: [modelId], references: [id], onDelete: Restrict)
  variant  ZirconiaVariant?  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  products ZirconiaProduct[]
  heights  ZirconiaHeight[]

  @@index([modelId, sortOrder])
  @@index([variantId, sortOrder])
}

/// Height available on one zirconia model.
model ZirconiaHeight {
  id          String    @id @default(cuid())
  modelId     String
  colorId     String?
  label       String
  quantity    Int?
  minQuantity Int?
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  model     ZirconiaModel           @relation(fields: [modelId], references: [id], onDelete: Restrict)
  color     ZirconiaColor?          @relation(fields: [colorId], references: [id], onDelete: Restrict)
  products  ZirconiaProduct[]
  movements ZirconiaStockMovement[]

  @@index([modelId, sortOrder])
  @@index([colorId, sortOrder])
}

/// One stock item: a color and height on a model. Quantity is the real balance.
model ZirconiaProduct {
  id         String    @id @default(cuid())
  modelId    String
  colorId    String
  heightId   String
  name       String    @default("")
  quantity   Int       @default(0)
  notes      String    @default("")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  model     ZirconiaModel           @relation(fields: [modelId], references: [id], onDelete: Restrict)
  color     ZirconiaColor           @relation(fields: [colorId], references: [id], onDelete: Restrict)
  height    ZirconiaHeight          @relation(fields: [heightId], references: [id], onDelete: Restrict)
  movements ZirconiaStockMovement[]

  @@unique([colorId, heightId])
  @@index([modelId, archivedAt])
}

model ZirconiaStockMovement {
  id             String              @id @default(cuid())
  productId      String?
  heightId       String?
  action         ZirconiaStockAction
  quantityChange Int
  quantityBefore Int
  quantityAfter  Int
  reason         String              @default("")
  countId        String?
  performedBy    String
  createdAt      DateTime            @default(now())

  product   ZirconiaProduct? @relation(fields: [productId], references: [id], onDelete: Restrict)
  height    ZirconiaHeight?  @relation(fields: [heightId], references: [id], onDelete: Restrict)
  performer User             @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([heightId, createdAt])
}

/// Titanium inventory category shown on the main inventory hub.
model TitaniumCategory {
  id           String    @id @default(cuid())
  name         String
  details      String    @default("")
  hubSortOrder Int       @default(6)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  models TitaniumModel[]
}

/// A titanium model such as G5. The name is editable; the id stays stable.
model TitaniumModel {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category TitaniumCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  radii    TitaniumRadius[]

  @@index([categoryId, sortOrder])
}

/// Radius defined by the manager under one titanium model.
model TitaniumRadius {
  id         String    @id @default(cuid())
  modelId    String
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  model TitaniumModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  sizes TitaniumSize[]

  @@index([modelId, sortOrder])
}

/// Size defined by the manager under one titanium radius.
model TitaniumSize {
  id         String    @id @default(cuid())
  radiusId   String
  label      String
  quantity   Int?
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  radius TitaniumRadius @relation(fields: [radiusId], references: [id], onDelete: Restrict)
  movements TitaniumStockMovement[]

  @@index([radiusId, sortOrder])
}

/// BMMA category. Display name is editable; no sample colors or heights are seeded.
model BmmaCategory {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models BmmaModel[]
  colors BmmaColor[]
}

/// Optional BMMA model. Colors can also exist directly on the category.
model BmmaModel {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category BmmaCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  colors   BmmaColor[]

  @@index([categoryId, sortOrder])
}

model BmmaColor {
  id         String    @id @default(cuid())
  categoryId String
  modelId    String?
  name       String
  colorCode  String    @default("")
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category BmmaCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  model    BmmaModel?   @relation(fields: [modelId], references: [id], onDelete: Restrict)
  heights  BmmaHeight[]

  @@index([categoryId, modelId, sortOrder])
}

/// One stock row for a color and height.
model BmmaHeight {
  id          String    @id @default(cuid())
  colorId     String
  label       String
  quantity    Int       @default(0)
  minQuantity Int       @default(0)
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  color      BmmaColor      @relation(fields: [colorId], references: [id], onDelete: Restrict)
  movements  BmmaMovement[]

  @@index([colorId, sortOrder])
}

model BmmaMovement {
  id           String          @id @default(cuid())
  heightId     String
  action       BmmaStockAction
  quantity     Int
  delta        Int
  balanceAfter Int
  reason       String
  countId      String?
  performedBy  String
  createdAt    DateTime        @default(now())

  height    BmmaHeight @relation(fields: [heightId], references: [id], onDelete: Restrict)
  performer User       @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([heightId, createdAt])
}

/// Free-form product stock for clinic materials and miscellaneous materials.
model SimpleStockItem {
  id         String          @id @default(cuid())
  kind       SimpleStockKind
  name       String
  quantity   Int             @default(0)
  unit       String          @default("")
  note       String          @default("")
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  movements SimpleStockMovement[]

  @@index([kind, archivedAt, name])
}

model SimpleStockMovement {
  id           String            @id @default(cuid())
  itemId       String
  action       SimpleStockAction
  quantity     Int
  delta        Int
  balanceAfter Int
  countId      String?
  performedBy  String
  createdAt    DateTime          @default(now())

  item      SimpleStockItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  performer User            @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
}

/// Implant system / company. MLS is seeded once and remains renameable.
model ImplantBrand {
  id         String    @id @default(cuid())
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  models ImplantModel[]

  @@index([sortOrder])
}

model ImplantModel {
  id         String    @id @default(cuid())
  brandId    String
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  brand ImplantBrand  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  types ImplantType[]

  @@index([brandId, sortOrder])
}

model ImplantType {
  id         String    @id @default(cuid())
  modelId    String
  name       String
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  model   ImplantModel    @relation(fields: [modelId], references: [id], onDelete: Restrict)
  heights ImplantHeight[]

  @@index([modelId, sortOrder])
}

/// One stock row for a company, model, type, and height.
model ImplantHeight {
  id          String    @id @default(cuid())
  typeId      String
  label       String
  quantity    Int       @default(0)
  minQuantity Int       @default(0)
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  type      ImplantType           @relation(fields: [typeId], references: [id], onDelete: Restrict)
  movements ImplantStockMovement[]

  @@index([typeId, sortOrder])
}

model ImplantStockMovement {
  id             String             @id @default(cuid())
  heightId       String
  action         ImplantStockAction
  quantityBefore Int
  quantity       Int
  delta          Int
  balanceAfter   Int
  reason         String             @default("")
  countId        String?
  performedBy    String
  createdAt      DateTime           @default(now())

  height    ImplantHeight @relation(fields: [heightId], references: [id], onDelete: Restrict)
  performer User          @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([heightId, createdAt])
}

/// Free-form doctor parts. Quantity may be negative.
model DoctorPart {
  id         String    @id @default(cuid())
  name       String
  code       String    @default("")
  quantity   Int       @default(0)
  unit       String    @default("")
  notes      String    @default("")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  orderParts OrderPart[]
  movements  DoctorPartMovement[]

  @@index([archivedAt, name])
}

/// Parts selected on one order. appliedQty is the amount currently deducted from stock.
model OrderPart {
  id         String   @id @default(cuid())
  orderId    String
  partId     String
  quantity   Int
  appliedQty Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part  DoctorPart @relation(fields: [partId], references: [id], onDelete: Restrict)

  @@unique([orderId, partId])
  @@index([partId])
}

model DoctorPartMovement {
  id             String                 @id @default(cuid())
  partId         String
  orderId        String?
  orderSerial    String                 @default("")
  operationId    String                 @unique
  type           DoctorPartMovementType
  quantityChange Int
  quantityBefore Int
  quantityAfter  Int
  userId         String
  reason         String                 @default("")
  source         String
  countId        String?
  createdAt      DateTime               @default(now())

  part  DoctorPart @relation(fields: [partId], references: [id], onDelete: Restrict)
  order Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([partId, createdAt])
  @@index([orderId])
  @@index([createdAt])
}

/// One inventory counting session. Approval is the only step that changes stock.
model InventoryCount {
  id              String               @id @default(cuid())
  inventoryType   InventoryModuleType
  serial          Int
  status          InventoryCountStatus @default(DRAFT)
  notes           String               @default("")
  counterName     String               @default("")
  location        String               @default("")
  countedItems    Int                  @default(0)
  changedItems    Int                  @default(0)
  unchangedItems  Int                  @default(0)
  differenceTotal Int                  @default(0)
  createdById     String
  approvedById    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  approvedAt      DateTime?
  cancelledAt     DateTime?

  createdBy  User                 @relation("InventoryCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?                @relation("InventoryCountApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  lines      InventoryCountLine[]

  @@unique([inventoryType, serial])
  @@index([inventoryType, status, createdAt])
}

model InventoryCountLine {
  id                     String  @id @default(cuid())
  countId                String
  itemId                 String
  name                   String
  modelName              String  @default("")
  kindName               String  @default("")
  colorName              String  @default("")
  sizeName               String  @default("")
  barcode                String  @default("")
  quantityAtStart        Int?
  countedQuantity        Int?
  quantityBeforeApproval Int?
  difference             Int?
  quantityAfter          Int?
  notes                  String  @default("")

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Restrict)

  @@unique([countId, itemId])
  @@index([countId])
}

model TitaniumStockMovement {
  id             String              @id @default(cuid())
  sizeId         String
  action         TitaniumStockAction
  quantityBefore Int
  quantityChange Int
  quantityAfter  Int
  reason         String              @default("")
  countId        String?
  performedBy    String
  createdAt      DateTime            @default(now())

  size      TitaniumSize @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  performer User         @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([sizeId, createdAt])
}

model DrillMachine {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  types DrillType[]

  @@index([sortOrder])
}

model DrillType {
  id         String    @id @default(cuid())
  machineId  String
  name       String
  note       String    @default("")
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  machine DrillMachine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  bits    DrillBit[]

  @@index([machineId, sortOrder])
}

model DrillBit {
  id         String    @id @default(cuid())
  typeId     String
  label      String
  quantity   Int?
  sortOrder  Int       @default(0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  type      DrillType            @relation(fields: [typeId], references: [id], onDelete: Restrict)
  movements DrillStockMovement[]

  @@index([typeId, sortOrder])
}

model DrillStockMovement {
  id             String          @id @default(cuid())
  bitId          String
  action         DrillStockAction
  quantityBefore Int
  quantityChange Int
  quantityAfter  Int
  reason         String          @default("")
  countId        String?
  performedBy    String
  createdAt      DateTime        @default(now())

  bit       DrillBit @relation(fields: [bitId], references: [id], onDelete: Restrict)
  performer User     @relation(fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([bitId, createdAt])
}

model InventoryImage {
  id          String   @id @default(cuid())
  module      String
  entityKind  String
  entityId    String
  storagePath String
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("InventoryImageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("InventoryImageUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([module, entityId])
  @@index([entityId, isPrimary])
}

model InventoryScanCode {
  id          String   @id @default(cuid())
  code        String   @unique
  module      String
  entityKind  String
  entityId    String
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("InventoryScanCodeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User @relation("InventoryScanCodeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([module, entityKind, entityId])
  @@index([module, entityId])
}

model Shipment {
  id           String    @id @default(cuid())
  orderId      String    @unique
  deliveryNote String    @unique
  packagedBy   String?
  packagedAt   DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  courierName  String?
  courierPhone String?
  notes        String?
  createdAt    DateTime  @default(now())
  /// Optional recipient signature PNG in Storage
  recipientSignaturePath String?
  recipientSignedAt      DateTime?
  recipientSignerName    String?
  recipientSignerUserId  String?
  recipientSignatureIp   String?
  recipientSignatureDeviceId String?
  /// When set, signature is read-only
  lockedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@index([deliveryNote])
}

model Payment {
  id              String         @id @default(cuid())
  doctorId        String?
  employeeId      String?
  orderId         String?
  serialNumber    String?
  patientName     String?
  amount          Float
  type            TransactionType
  status          PaymentStatus
  description     String?
  paidAt          DateTime?
  paymentMethod   PaymentMethod?
  referenceNumber String?
  deliveryNote    String?
  createdAt       DateTime       @default(now())

  doctor   Doctor? @relation(fields: [doctorId], references: [id])
  employee User?   @relation("EmployeePayments", fields: [employeeId], references: [id])
  order    Order?  @relation(fields: [orderId], references: [id])

  @@index([doctorId, createdAt])
  @@index([employeeId, createdAt])
  @@index([orderId])
  @@index([type, status])
}

model AttendanceRecord {
