  userId            String
  checkIn           DateTime
  checkOut          DateTime?
  method            AttendanceMethod
  trustedDeviceId   String?
  ipAddress         String?
  nfcTagId          String?
  latitude          Float?
  longitude         Float?
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkInAccuracy   Float?
  checkInAddress    String?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkOutAccuracy  Float?
  checkOutAddress   String?
  checkInAddressCountry     String?
  checkInAddressCity        String?
  checkInAddressStreet      String?
  checkInAddressHouseNumber String?
  checkOutAddressCountry     String?
  checkOutAddressCity        String?
  checkOutAddressStreet      String?
  checkOutAddressHouseNumber String?
  checkInDeviceBrowser  String?
  checkInDeviceOs       String?
  checkInDeviceType     String?
  checkInUserAgent      String?
  checkInScreenSize     String?
  checkInTimezone       String?
